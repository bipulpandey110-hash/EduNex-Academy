DJANGO_SECRET_KEY=generate-a-long-random-secret-before-deploy
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-api-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com
# Set DATABASE_URL on managed PostgreSQL hosts, or use POSTGRES_* below.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_DB=edunex
POSTGRES_USER=edunex
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
